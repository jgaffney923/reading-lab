{
  "boot.welcome": { "text": "Hi, scientist! Let's read and do experiments!", "recorded": false },
  "home.pick": { "text": "Pick a machine!", "recorded": false },
  "home.levelUp": { "text": "Wow! You unlocked new letters! Listen.", "recorded": false },

  "praise.1": { "text": "You got it!", "recorded": false },
  "praise.2": { "text": "Great reading!", "recorded": false },
  "praise.3": { "text": "Awesome, scientist!", "recorded": false },
  "praise.4": { "text": "Yes!", "recorded": false },
  "praise.5": { "text": "Nice mixing!", "recorded": false },
  "effort.1": { "text": "Great effort!", "recorded": false },
  "effort.2": { "text": "Nice experimenting!", "recorded": false },
  "effort.3": { "text": "That's it!", "recorded": false },

  "soundlab.intro": { "text": "This is the Sound Lab! I'll say a sound. You tap the letter that makes that sound.", "recorded": false },
  "soundlab.find": { "text": "Find the letter that says", "recorded": false },
  "soundlab.listen": { "text": "Let's listen again.", "recorded": false },

  "mixer.intro": { "text": "This is the Word Mixer! Touch each letter to hear its sound. Then slide along the arrow to mix the sounds into a word.", "recorded": false },
  "mixer.touch": { "text": "Touch each letter to hear its sound.", "recorded": false },
  "mixer.slide": { "text": "Slide along the arrow to mix the sounds. Faster makes a word!", "recorded": false },
  "mixer.which": { "text": "Which picture is it?", "recorded": false },
  "mixer.thatOne": { "text": "That one is", "recorded": false },
  "mixer.listen": { "text": "Let's listen to the sounds together.", "recorded": false },

  "reward.full": { "text": "The lab energy is full! Tap the big button to start the experiment!", "recorded": false },
  "reward.rocket": { "text": "Three, two, one, blast off!", "recorded": false },
  "reward.volcano": { "text": "Whoa! The volcano is erupting!", "recorded": false },
  "reward.potion": { "text": "Look at all the colors!", "recorded": false },
  "reward.again": { "text": "Great work, scientist! Play again, or go home.", "recorded": false },

  "snd.s": { "text": "sss", "speak": "sss", "note": "Hold it like a snake, about a second. No 'uh'.", "recorded": false },
  "snd.a": { "text": "a (as in ant)", "speak": "aah", "note": "Short a, the start of 'ant'. Hold it about a second.", "recorded": false },
  "snd.t": { "text": "t", "speak": "tuh", "note": "Short and crisp, just a puff of air. No 'tuh'.", "recorded": false },
  "snd.p": { "text": "p", "speak": "puh", "note": "Short and crisp, just a puff of air. No 'puh'.", "recorded": false },
  "snd.i": { "text": "i (as in itch)", "speak": "ih", "note": "Short i, the start of 'itch'. Hold it about a second.", "recorded": false },
  "snd.n": { "text": "nnn", "speak": "nnn", "note": "Hold it, humming through your nose, about a second.", "recorded": false },
  "snd.m": { "text": "mmm", "speak": "mmm", "note": "Hold it, lips together, about a second.", "recorded": false },
  "snd.d": { "text": "d", "speak": "duh", "note": "Short and crisp. No 'duh'.", "recorded": false },
  "snd.o": { "text": "o (as in octopus)", "speak": "ah", "note": "Short o, the start of 'octopus'. Hold it about a second.", "recorded": false },
  "snd.g": { "text": "g", "speak": "guh", "note": "Short and crisp, from the back of the throat. No 'guh'.", "recorded": false },
  "snd.c": { "text": "c (as in cat)", "speak": "kuh", "note": "The hard 'k' sound, short and crisp. Record the same as k.", "recorded": false },
  "snd.k": { "text": "k", "speak": "kuh", "note": "Short and crisp. No 'kuh'.", "recorded": false },
  "snd.e": { "text": "e (as in egg)", "speak": "eh", "note": "Short e, the start of 'egg'. Hold it about a second.", "recorded": false },
  "snd.u": { "text": "u (as in up)", "speak": "uh", "note": "Short u, the start of 'up'. Hold it about a second.", "recorded": false },
  "snd.h": { "text": "h", "speak": "huh", "note": "Just a breath out, like fogging a window. No 'huh'.", "recorded": false },
  "snd.b": { "text": "b", "speak": "buh", "note": "Short and crisp. No 'buh'.", "recorded": false },
  "snd.r": { "text": "rrr", "speak": "rrr", "note": "Hold it like a growl, about a second. Not 'er' or 'ruh'.", "recorded": false },
  "snd.f": { "text": "fff", "speak": "fff", "note": "Hold it, top teeth on your lip, about a second.", "recorded": false },
  "snd.l": { "text": "lll", "speak": "lll", "note": "Hold it, tongue behind your top teeth, about a second. Not 'luh'.", "recorded": false },
  "snd.w": { "text": "w", "speak": "wuh", "note": "Round lips, short. No 'wuh'.", "recorded": false },
  "snd.v": { "text": "vvv", "speak": "vvv", "note": "Hold it, a buzzy 'f', about a second.", "recorded": false },
  "snd.x": { "text": "ks (as at the end of box)", "speak": "ks", "note": "The 'ks' at the end of 'box'. Short.", "recorded": false },
  "snd.z": { "text": "zzz", "speak": "zzz", "note": "Hold it like a buzzing bee, about a second.", "recorded": false },
  "snd.j": { "text": "j", "speak": "juh", "note": "Short and crisp. No 'juh'.", "recorded": false },
  "snd.y": { "text": "y (as in yes)", "speak": "yuh", "note": "Short, the start of 'yes'. No 'yuh'.", "recorded": false },

